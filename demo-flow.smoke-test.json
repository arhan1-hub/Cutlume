{
  "name": "cutlume-smoke-success",
  "baseUrl": "http://127.0.0.1:4173/demo-smoke-test.html",
  "outputDir": "recordings",
  "viewport": { "width": 1280, "height": 800 },
  "steps": [
    { "action": "waitForSelector", "selector": "body", "label": "Wait for fixture" },
    { "action": "fill", "selector": "#prompt", "value": "hello Cutlume", "label": "Enter test prompt", "caption": "Start with a clear prompt" },
    { "action": "click", "selector": "#run", "label": "Generate answer", "caption": "Let Cutlume replay the workflow", "effect": "spotlight" },
    { "action": "waitForText", "text": "Smoke-test answer for: hello Cutlume", "label": "Wait for answer", "caption": "Wait for the answer to finish" }
  ]
}
